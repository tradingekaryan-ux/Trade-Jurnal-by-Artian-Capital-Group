# Trade Jurnal by Artian Capital Group — konfigurasi server
# Semua variabel di bawah opsional untuk pengembangan lokal, tetapi WAJIB untuk produksi.

# WAJIB: kunci OpenRouter untuk fitur AI (dibaca server, tidak pernah dikirim ke browser).
# Bisa beberapa kunci sebagai fallback, dipisah koma. Kunci berikutnya dipakai otomatis
# bila kunci sebelumnya kena auth/saldo/rate-limit. Jangan commit nilai asli ke git.
OPENROUTER_API_KEYS=
# Alternatif satu kunci (tetap didukung, digabung dengan daftar di atas).
OPENROUTER_API_KEY=

# WAJIB di produksi: rahasia untuk menandatangani cookie session.
AUTH_SECRET=

# Disarankan: URL publik aplikasi, dikirim sebagai header HTTP-Referer ke OpenRouter.
SITE_URL=http://localhost:3000

# Sumber kunci enkripsi untuk kredensial broker & kunci BYOK pengguna.
# Default: file kunci acak di direktori data. Simpan nilainya terpisah dari backup.
JOURNAL_SECRET=

# Direktori data (database global + database per pengguna + lampiran).
# Default: ./data relatif terhadap proses aplikasi.
JOURNAL_DATA_DIR=

# Opsional: endpoint OpenRouter (default https://openrouter.ai/api/v1) dan model awal.
# Daftar model lengkap & status Free/Paid dikelola di halaman Admin → Model AI.
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=

# Opsional: username yang akan otomatis menjadi admin saat registrasi.
# Pengguna pertama yang mendaftar selalu menjadi admin.
ADMIN_USERNAME=

# Akun owner khusus, dibuat otomatis saat aplikasi pertama kali berjalan.
# Jika OWNER_PASSWORD kosong, password acak ditulis ke data/owner-credentials.txt.
OWNER_USERNAME=
OWNER_PASSWORD=

# Tombol Discord mengambang — isi dengan URL invite server Anda.
NEXT_PUBLIC_DISCORD_URL=

# Supabase Postgres — seluruh data aplikasi disimpan di sini (bukan di kontainer).
# Letakkan di apps/web/.env.local untuk lokal, dan sebagai secret di Northflank.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Gambar diunggah ke imgdb.io (API publik, tanpa key). Tidak ada variabel tambahan.
